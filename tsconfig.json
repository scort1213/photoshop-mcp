{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/index.ts",
    "src/api/**/*",
    "src/core/**/*",
    "src/errors/**/*",
    "src/lib/**/*",
    "src/platform/**/*",
    "src/prompts/**/*",
    "src/tools/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/analytics/**/*",
    "src/ui/cli.ts",
    "src/ui/server.ts",
    "src/ui/local-only.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
