# This fork permanently disables analytics and standalone cloud chat.
# Old RYBBIT_*, POSTHOG_DISABLED and ANALYTICS_DISABLED values cannot enable tracking.
# Set environment variables in the MCP client's process configuration.
LOG_LEVEL=2
# PHOTOSHOP_PATH=/absolute/path/to/Photoshop
# PHOTOSHOP_EXPORT_DIR=/absolute/path/to/local/exports
