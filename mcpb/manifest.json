{
  "$schema": "https://raw.githubusercontent.com/anthropics/mcpb/main/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "photoshop-mcp",
  "display_name": "Photoshop MCP — local-only",
  "version": "0.0.0",
  "description": "Local Photoshop editing; built-in cloud tools, analytics and standalone chat disabled.",
  "long_description": "Controls local Photoshop on macOS and Windows. Select Subject / background removal require Device processing in Photoshop preferences. Custom scripts remain trusted and unsandboxed. Adobe licensing and background traffic are outside this integration policy.",
  "author": {
    "name": "Ali Sait Teke",
    "url": "https://alisait.com"
  },
  "homepage": "https://github.com/scort1213/photoshop-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/scort1213/photoshop-mcp"
  },
  "documentation": "https://github.com/scort1213/photoshop-mcp/blob/codex/local-only/LOCAL_ONLY.md",
  "support": "https://github.com/scort1213/photoshop-mcp/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "photoshop",
    "adobe",
    "image-editing",
    "automation"
  ],
  "server": {
    "type": "node",
    "entry_point": "server/dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/dist/index.js"
      ],
      "env": {
        "LOG_LEVEL": "${user_config.logLevel}",
        "PHOTOSHOP_PATH": "${user_config.photoshopPath}"
      }
    }
  },
  "user_config": {
    "logLevel": {
      "type": "string",
      "title": "Log level",
      "description": "0=DEBUG, 1=INFO, 2=WARN, 3=ERROR",
      "default": "1",
      "enum": [
        "0",
        "1",
        "2",
        "3"
      ]
    },
    "photoshopPath": {
      "type": "string",
      "title": "Photoshop install path",
      "description": "Optional. Leave empty to auto-detect the local Photoshop install.",
      "required": false
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "tools_generated": true,
  "prompts_generated": true
}
