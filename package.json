{
  "name": "@alisaitteke/photoshop-mcp",
  "version": "1.7.14",
  "description": "Local-only MCP server for Adobe Photoshop. No standalone cloud chat UI or analytics.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "photoshop-mcp": "dist/index.js",
    "photoshop-mcp-ui": "dist/ui/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "scripts/prepare.mjs",
    "README.md",
    "LICENSE",
    "llms.txt",
    "AGENTS.md",
    "scripts/ui-unavailable.mjs",
    "README.zh-CN.md",
    "LOCAL_ONLY.md",
    "LOCAL_ONLY_ACCEPTANCE.md"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "dev:ui": "node scripts/ui-unavailable.mjs",
    "dev:ui:server": "node scripts/ui-unavailable.mjs",
    "dev:ui:web": "node scripts/ui-unavailable.mjs",
    "build": "npm run build:server",
    "build:server": "node scripts/clean-dist.mjs && tsc",
    "build:web": "node scripts/ui-unavailable.mjs",
    "build:site": "npm --prefix site run build",
    "start": "node dist/index.js",
    "start:ui": "node dist/ui/cli.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "spike:issue-2": "tsx scripts/spike-issue-2.ts",
    "verify:photoshop-prompts": "tsx scripts/verify-photoshop-prompt-coverage.ts",
    "verify:pack": "node scripts/verify-pack.mjs",
    "test:mcp-local": "tsx scripts/test-mcp-local.ts",
    "test:ui-auth": "vitest run tests/local-only-ui.test.ts",
    "test:mcp-all": "tsx scripts/test-all-mcp-tools.ts",
    "test:intent-expansion": "tsx scripts/test-intent-expansion-local.ts",
    "prepare": "node scripts/prepare.mjs",
    "build:mcpb": "tsx scripts/build-mcpb.ts",
    "test:unit": "vitest run",
    "verify:tool-counts": "tsx scripts/verify-tool-counts.ts",
    "site:data": "tsx scripts/generate-site-data.ts",
    "test:analytics": "vitest run tests/analytics-context.test.ts tests/analytics-mcp-session.test.ts",
    "sync:server-version": "tsx scripts/sync-server-version.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "photoshop",
    "adobe",
    "automation",
    "ai",
    "cursor",
    "claude",
    "image-editing",
    "typescript",
    "extendscript",
    "developer-tools"
  ],
  "author": "Ali Sait Teke (https://alisait.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scort1213/photoshop-mcp.git"
  },
  "homepage": "https://github.com/scort1213/photoshop-mcp",
  "bugs": {
    "url": "https://github.com/scort1213/photoshop-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "private": true
}
